{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"jsx": "react-jsx",
		"types": ["vite/client"],
		// `@archant/api` and `@archant/data` are imported straight from source,
		// whose relative imports carry their `.ts` extension.
		"allowImportingTsExtensions": true,
		"paths": { "@/*": ["./src/*"] }
	},
	"include": ["src/**/*.ts", "src/**/*.tsx", "e2e/**/*.ts", "*.config.ts"],
	"exclude": ["node_modules", "dist"]
}
