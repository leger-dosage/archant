{
	"name": "@archant/api",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		"./app": "./src/app.ts",
		"./schemas/accounts": "./src/schemas/accounts.ts",
		"./schemas/balances": "./src/schemas/balances.ts",
		"./schemas/categories": "./src/schemas/categories.ts",
		"./schemas/imports": "./src/schemas/imports.ts",
		"./schemas/setup": "./src/schemas/setup.ts",
		"./schemas/snapshots": "./src/schemas/snapshots.ts",
		"./schemas/transactions": "./src/schemas/transactions.ts"
	},
	"scripts": {
		"start:dev": "node --env-file-if-exists=../../.env --watch src/index.ts",
		"start": "node src/index.ts",
		"reset-password": "node --env-file-if-exists=../../.env src/cli/reset-password.ts",
		"typecheck": "tsc -p tsconfig.json",
		"test": "vitest run --coverage"
	},
	"dependencies": {
		"@archant/data": "workspace:*",
		"@hono/node-server": "^2.1.1",
		"@hono/zod-validator": "^0.9.1",
		"@t3-oss/env-core": "catalog:",
		"better-auth": "catalog:",
		"drizzle-orm": "catalog:",
		"hono": "catalog:",
		"ofx-js": "1.1.1",
		"papaparse": "5.7.0",
		"pino": "^10.3.1",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"@types/papaparse": "^5.5.2",
		"@vitest/coverage-v8": "^5.0.1",
		"msw": "^2.15.0",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
