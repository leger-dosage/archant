{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"lib": ["ES2023"],
		"types": ["node"],
		// The server runs straight from source through Node's type stripping, so
		// imports keep their `.ts` extension for Node's ESM resolver.
		"allowImportingTsExtensions": true
	},
	"include": ["**/*.ts"],
	"exclude": ["node_modules", "coverage"]
}
