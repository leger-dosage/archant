# Copy to `.env` and fill in. Never commit `.env`.
# Every variable is validated at startup by @t3-oss/env-core; a missing required
# one fails fast rather than producing a confusing error later.

# --- Database -----------------------------------------------------------------
# Local file for development and self-hosting, or a Turso URL in the cloud.
# A relative path resolves against the working directory, which is the package
# directory for every `pnpm data` and `pnpm api` script: `../../local.db` is the
# repository root for both. Use an absolute path in production.
# Example local:  file:../../local.db
# Example Turso:  libsql://archant-<org>.turso.io
DATABASE_URL=file:../../local.db
# Required for Turso only; leave empty for a local file.
DATABASE_AUTH_TOKEN=

# --- Server -------------------------------------------------------------------
# Port the API listens on. Defaults to 8787. The web dev server and preview
# proxy `/api` to the same port, so change it here rather than in one of them.
PORT=8787
# Time zone that decides what "today" is for balances. Defaults to Europe/Paris.
APP_TIMEZONE=Europe/Paris
# pino level: fatal, error, warn, info, debug, trace or silent. Defaults to info.
LOG_LEVEL=info

# --- Authentication -----------------------------------------------------------
# Required: the API refuses to start without it. Signs session cookies; at
# least 32 characters. Generate with: openssl rand -base64 32
# Rotating it signs every user out.
BETTER_AUTH_SECRET=
# Required: the API refuses to start without it. The origin the browser uses,
# not the API's port: the Vite dev server in development, the public URL in
# production. A sign-in or an upload from any other origin is refused.
BETTER_AUTH_URL=http://localhost:5173
# Optional. Comma-separated IPs or CIDR ranges of the reverse proxies in front
# of the API, such as 127.0.0.1 for Caddy or nginx on the same machine. Only
# their X-Forwarded-For header is believed. Empty, the client address is the
# direct connection, so no visitor can fake one. Behind a reverse proxy that is
# not listed here, every visitor looks like the proxy and they all share one
# sign-in limit: three failed attempts by a stranger lock you out for ten seconds.
TRUSTED_PROXIES=

# --- Enable Banking (PSD2) ----------------------------------------------------
# Application id from the Enable Banking control panel, and the private key that
# signs the JWT it expects. Without these, bank sync is unavailable and only file
# import works.
ENABLE_BANKING_APPLICATION_ID=
ENABLE_BANKING_PRIVATE_KEY=

# --- Scheduled sync -----------------------------------------------------------
# Shared secret expected by POST /api/sync. Any scheduler that knows it can
# trigger a synchronisation, so treat it like a password.
SYNC_SECRET=
