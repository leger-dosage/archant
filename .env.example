# Copy to `.env` and fill in. Never commit `.env`.
# Every variable is validated at startup by @t3-oss/env-core; a missing required
# one fails fast rather than producing a confusing error later.

# --- Database -----------------------------------------------------------------
# Local file for development and self-hosting, or a Turso URL in the cloud.
# A relative path resolves against the working directory, which is the package
# directory for every `pnpm data` and `pnpm api` script: `../../local.db` is the
# repository root for both. Use an absolute path in production.
# Example local:  file:../../local.db
# Example Turso:  libsql://archant-<org>.turso.io
DATABASE_URL=file:../../local.db
# Required for Turso only; leave empty for a local file.
DATABASE_AUTH_TOKEN=

# --- Server -------------------------------------------------------------------
# Port the API listens on. Defaults to 8787. The web dev server and preview
# proxy `/api` to the same port, so change it here rather than in one of them.
PORT=8787
# Time zone that decides what "today" is for balances. Defaults to Europe/Paris.
APP_TIMEZONE=Europe/Paris
# pino level: fatal, error, warn, info, debug, trace or silent. Defaults to info.
LOG_LEVEL=info
# Optional. Absolute path to the built interface (`pnpm web build` writes
# packages/web/dist), which the API then serves under `/` beside `/api`. Empty,
# the API serves no page, as in development where Vite serves the interface.
# The container sets it to /app/packages/web/dist.
WEB_DIST=

# --- Authentication -----------------------------------------------------------
# Required: the API refuses to start without it. Signs session cookies; at
# least 32 characters. Generate with: openssl rand -base64 32
# Rotating it signs every user out.
BETTER_AUTH_SECRET=
# Required: the API refuses to start without it. The origin the browser uses,
# not the API's port: the Vite dev server in development, the public URL in
# production. A sign-in or an upload from any other origin is refused.
BETTER_AUTH_URL=http://localhost:5173
# Optional. Comma-separated IPs or CIDR ranges of the reverse proxies in front
# of the API, such as 127.0.0.1 for Caddy or nginx on the same machine. Only
# their X-Forwarded-For header is believed. Empty, the client address is the
# direct connection, so no visitor can fake one. Behind a reverse proxy that is
# not listed here, every visitor looks like the proxy and they all share one
# sign-in limit: three failed attempts by a stranger lock you out for ten seconds.
TRUSTED_PROXIES=

# --- Container ----------------------------------------------------------------
# Read by docker-compose.yml only, which passes it to the container as
# BETTER_AUTH_URL: the address the browser uses to reach it. Defaults to
# http://localhost:8787; set it to the public URL behind a reverse proxy, or
# every sign-in from that URL is refused. The container ignores the
# DATABASE_URL and BETTER_AUTH_URL above, which point at development servers.
ARCHANT_URL=

# --- Enable Banking (PSD2) ----------------------------------------------------
# Optional. Connecting a bank needs all three of ENABLE_BANKING_APPLICATION_ID,
# ENABLE_BANKING_PRIVATE_KEY and ENCRYPTION_KEY. Without them the bank routes
# answer 503, Réglages > Banques names what is missing, and file import keeps
# working. A value that is set but unreadable stops the server at startup.
# Application id from the Enable Banking control panel.
ENABLE_BANKING_APPLICATION_ID=
# The application's private key, as base64 of the PEM file (PKCS#1 or PKCS#8):
#   base64 < private.pem | tr -d '\n'
ENABLE_BANKING_PRIVATE_KEY=
# Encrypts bank session ids at rest: base64 of exactly 32 random bytes.
# Generate with: openssl rand -base64 32
# Losing or changing it means reconnecting every bank.
ENCRYPTION_KEY=
# Defaults to https://api.enablebanking.com. Only tests point it elsewhere.
ENABLE_BANKING_API_URL=
# The bank sends the browser back to BETTER_AUTH_URL + /settings/banks/callback,
# for instance http://localhost:5173/settings/banks/callback in development.
# Register that exact URL as a redirect URL of the application in the Enable
# Banking control panel, or every connection is refused.

# --- Scheduled sync -----------------------------------------------------------
# Optional. The bearer token POST /api/sync expects, at least 32 characters.
# Any scheduler that knows it can trigger a synchronisation, so treat it like a
# password. Without it the route answers 401 to every call, and banks sync only
# from the « Synchroniser » button of a connection.
# Generate with: openssl rand -base64 32
SYNC_SECRET=
