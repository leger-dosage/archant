{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	// Registration is separate from rule adoption so setup does not change the
	// existing UI policy before its violations have been measured.
	"jsPlugins": ["@shadcn/lint"],
	"plugins": ["typescript", "unicorn", "import", "promise"],
	"options": {
		"typeAware": true
	},
	"categories": {
		"correctness": "error",
		"suspicious": "error",
		"perf": "warn"
	},
	"rules": {
		// A money app must never lose a branch to an implicit fallthrough, and a
		// forgotten `await` on a provider call silently drops a sync. These two are
		// the reason type-aware linting is enabled at all.
		"typescript/no-floating-promises": "error",
		"typescript/no-misused-promises": "error",

		"eslint/curly": ["error", "all"],
		// Stylesheets and font faces are imported for their side effect by design.
		"import/no-unassigned-import": ["error", { "allow": ["**/*.css"] }],
		// The ledger and the rules once imported each other, so neither could be
		// read or loaded without the other; a cycle now fails the gate.
		"import/no-cycle": "error",
		"eslint/eqeqeq": ["error", "always"],
		"eslint/no-console": ["error", { "allow": ["warn", "error"] }],
		"eslint/no-unused-vars": [
			"error",
			{
				"vars": "all",
				"varsIgnorePattern": "^_",
				"args": "after-used",
				"argsIgnorePattern": "^_"
			}
		],

		"typescript/consistent-type-imports": [
			"error",
			{ "prefer": "type-imports", "fixStyle": "separate-type-imports" }
		],

		// `as any` and `as never` silence the compiler exactly where the domain is
		// hardest: amounts, currencies, provider payloads. These two rules cover the
		// same ground as the ESLint `no-restricted-syntax` selectors they replace,
		// which oxlint does not implement.
		"typescript/no-explicit-any": "error",
		"typescript/no-unsafe-assignment": "error",
		"typescript/no-unsafe-argument": "error",
		"typescript/no-unsafe-return": "error"
	},
	// AD-1 and AD-2 of the architecture spine, enforced rather than remembered.
	// Later overrides replace the rule for the files they match, so the order
	// goes from the broadest glob to the narrowest.
	"overrides": [
		{
			// Only the ledger writes money rows. Any other module reaching for
			// these tables would compute or store a balance its own way.
			"files": ["packages/api/src/**"],
			"rules": {
				"eslint/no-restricted-imports": [
					"error",
					{
						"paths": [
							{
								"name": "@archant/data/schema/entries",
								"message": "Only services/ledger/ writes entries (AD-2)."
							},
							{
								"name": "@archant/data/schema/balances",
								"message": "Only services/ledger/ writes balances; read them through balanceOn (AD-2, AD-8)."
							},
							{
								"name": "@archant/data/schema/transactions",
								"message": "Only services/ledger/ writes transactions (AD-2)."
							},
							{
								"name": "@archant/data/schema/transfers",
								"message": "Only services/ledger/ writes transfers (AD-2)."
							},
							{
								"name": "@archant/data/schema/rejected-transfers",
								"message": "Only services/ledger/ writes rejected transfers (AD-2)."
							},
							{
								"name": "@archant/data/schema/entry-keys",
								"message": "Only services/ledger/ writes entry keys (AD-2, AD-7)."
							},
							{
								"name": "@archant/data/schema/taggings",
								"message": "Only services/ledger/ links tags to transactions (AD-2)."
							},
							{
								"name": "@archant/data/schema/imports",
								"message": "Only services/ledger/ confirms imports (AD-2, AD-4).",
								"allowTypeImports": true
							}
						]
					}
				]
			}
		},
		{
			// The domain stays pure so balance calculation is testable without a
			// server or a database.
			"files": ["packages/api/src/domain/**"],
			"rules": {
				"eslint/no-restricted-imports": [
					"error",
					{
						"paths": [
							{ "name": "drizzle-orm", "message": "The domain is pure (AD-1)." },
							{ "name": "hono", "message": "The domain is pure (AD-1)." },
							// Repeated from the override above, which this one replaces. The
							// domain may name these rows' types, never touch the tables (AD-2).
							{
								"name": "@archant/data/schema/entries",
								"message": "The domain may import entry types only (AD-2).",
								"allowTypeImports": true
							},
							{
								"name": "@archant/data/schema/balances",
								"message": "The domain may import balance types only (AD-2).",
								"allowTypeImports": true
							},
							{
								"name": "@archant/data/schema/transactions",
								"message": "The domain may import transaction types only (AD-2).",
								"allowTypeImports": true
							},
							{
								"name": "@archant/data/schema/transfers",
								"message": "The domain may import transfer types only (AD-2).",
								"allowTypeImports": true
							},
							{
								"name": "@archant/data/schema/rejected-transfers",
								"message": "The domain may import rejected transfer types only (AD-2).",
								"allowTypeImports": true
							},
							{
								"name": "@archant/data/schema/entry-keys",
								"message": "The domain may import entry key types only (AD-2).",
								"allowTypeImports": true
							},
							{
								"name": "@archant/data/schema/taggings",
								"message": "The domain may import tagging types only (AD-2).",
								"allowTypeImports": true
							},
							{
								"name": "@archant/data/schema/imports",
								"message": "The domain may import import types only (AD-2).",
								"allowTypeImports": true
							}
						],
						"patterns": [
							{ "group": ["drizzle-orm/*", "hono/*"], "message": "The domain is pure (AD-1)." },
							{
								"group": ["**/services/**"],
								"message": "The domain may not call services (AD-1)."
							},
							{
								"group": ["**/connectors/**"],
								"message": "The domain may not call connectors (AD-1)."
							}
						]
					}
				]
			}
		},
		{
			// A connector turns bytes or a provider response into a statement. It
			// never touches the database, so a parser runs in a test without one.
			"files": ["packages/api/src/connectors/**"],
			"rules": {
				"eslint/no-restricted-imports": [
					"error",
					{
						"paths": [
							{
								"name": "drizzle-orm",
								"message": "Connectors never touch the database (AD-1, AD-3)."
							},
							// Repeated from the first override, which this one replaces.
							{
								"name": "@archant/data/schema/entries",
								"message": "Connectors never touch the database (AD-3).",
								"allowTypeImports": true
							},
							{
								"name": "@archant/data/schema/balances",
								"message": "Connectors never touch the database (AD-3).",
								"allowTypeImports": true
							},
							{
								"name": "@archant/data/schema/transactions",
								"message": "Connectors never touch the database (AD-3).",
								"allowTypeImports": true
							},
							{
								"name": "@archant/data/schema/transfers",
								"message": "Connectors never touch the database (AD-3).",
								"allowTypeImports": true
							},
							{
								"name": "@archant/data/schema/rejected-transfers",
								"message": "Connectors never touch the database (AD-3).",
								"allowTypeImports": true
							},
							{
								"name": "@archant/data/schema/entry-keys",
								"message": "Connectors never touch the database (AD-3).",
								"allowTypeImports": true
							},
							{
								"name": "@archant/data/schema/taggings",
								"message": "Connectors never touch the database (AD-3).",
								"allowTypeImports": true
							},
							{
								"name": "@archant/data/schema/imports",
								"message": "Connectors never touch the database (AD-3).",
								"allowTypeImports": true
							}
						],
						"patterns": [
							{
								"group": ["drizzle-orm/*"],
								"message": "Connectors never touch the database (AD-1, AD-3)."
							},
							{
								"group": ["**/services/**"],
								"message": "Connectors may not call services (AD-1)."
							}
						]
					}
				]
			}
		},
		{
			// Uploading stores a previewed import and the start purges stale ones;
			// confirming it stays the ledger's, in the same transaction as the
			// entries (AD-4). The other ledger tables stay out of reach.
			"files": ["packages/api/src/services/imports.ts"],
			"rules": {
				"eslint/no-restricted-imports": [
					"error",
					{
						"paths": [
							{
								"name": "@archant/data/schema/entries",
								"message": "Only services/ledger/ writes entries (AD-2)."
							},
							{
								"name": "@archant/data/schema/balances",
								"message": "Only services/ledger/ writes balances; read them through balanceOn (AD-2, AD-8)."
							},
							{
								"name": "@archant/data/schema/transactions",
								"message": "Only services/ledger/ writes transactions (AD-2)."
							},
							{
								"name": "@archant/data/schema/transfers",
								"message": "Only services/ledger/ writes transfers (AD-2)."
							},
							{
								"name": "@archant/data/schema/rejected-transfers",
								"message": "Only services/ledger/ writes rejected transfers (AD-2)."
							},
							{
								"name": "@archant/data/schema/entry-keys",
								"message": "Only services/ledger/ writes entry keys (AD-2, AD-7)."
							},
							{
								"name": "@archant/data/schema/taggings",
								"message": "Only services/ledger/ links tags to transactions (AD-2)."
							}
						]
					}
				]
			}
		},
		{
			// The volume spec seeds 100,000 rows directly, as the ledger's own spec
			// does: through the ledger, ten years of balances per row would take
			// longer than any test may.
			"files": [
				"packages/api/src/services/ledger/**",
				"packages/api/src/services/ledger.spec.ts",
				"packages/api/src/services/history-volume.spec.ts"
			],
			"rules": {
				"eslint/no-restricted-imports": "off"
			}
		}
	],
	"ignorePatterns": [
		"dist",
		"coverage",
		"_bmad",
		"_bmad-output",
		".agents",
		".claude",
		"**/drizzle",
		// Written by the TanStack Router plugin on every dev, build and test run.
		"**/routeTree.gen.ts"
	]
}
