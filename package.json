{
	"name": "archant",
	"private": true,
	"type": "module",
	"scripts": {
		"api": "pnpm --filter @archant/api",
		"app": "pnpm --filter @archant/app",
		"data": "pnpm --filter @archant/data",
		"format": "oxfmt .",
		"lint:code": "oxlint --type-aware --max-warnings 0 --no-error-on-unmatched-pattern",
		"lint:format": "oxfmt --check .",
		"typecheck": "pnpm -r typecheck",
		"test": "pnpm -r test",
		"test:e2e": "pnpm --filter @archant/app test:e2e"
	},
	"devDependencies": {
		"@shadcn/lint": "^0.2.0",
		"oxfmt": "^0.70.0",
		"oxlint": "^1.85.0",
		"oxlint-tsgolint": "^7.0.2003",
		"typescript": "~7.0.2"
	},
	"packageManager": "pnpm@10.34.5"
}
