{
	"name": "archant",
	"private": true,
	"type": "module",
	"scripts": {
		"api": "pnpm --filter @archant/api",
		"app": "pnpm --filter @archant/app",
		"data": "pnpm --filter @archant/data",
		"format": "oxfmt .",
		"lint:code": "oxlint --type-aware --max-warnings 0 --no-error-on-unmatched-pattern && knip",
		"lint:format": "oxfmt --check .",
		"typecheck": "pnpm -r typecheck",
		"test": "pnpm -r test",
		"test:e2e": "pnpm --filter @archant/app test:e2e"
	},
	"devDependencies": {
		"@shadcn/lint": "^0.2.0",
		"knip": "^6.40.0",
		"oxfmt": "^0.72.0",
		"oxlint": "^1.87.0",
		"oxlint-tsgolint": "^7.0.2003",
		"typescript": "^7.0.2"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e"
}
